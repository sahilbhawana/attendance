# Local admin login. Change these before putting the app on the internet.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Keep blank to use the address from the browser/host.
PUBLIC_BASE_URL=

# Attendance protections. Phone location works on HTTPS (or localhost).
LOCATION_REQUIRED=true
GPS_RADIUS_METERS=50
QR_VALIDITY_MINUTES=5
QR_ROTATE_SECONDS=15
SUBJECT_COOLDOWN_HOURS=12
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false

# For local use SQLite is created automatically. A hosted service should set
# DATABASE_URL to a persistent PostgreSQL database.
