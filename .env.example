# Local admin login. Change these before putting the app on the internet.
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Keep blank for local computer-only use. On the hosted site the QR uses its
# incoming HTTPS address automatically. Put a full URL here only to override it.
PUBLIC_BASE_URL=

# Location checks are off by default so phone browsers do not block check-in.
# Set true only if your site uses HTTPS and you want GPS radius validation.
LOCATION_REQUIRED=false
GPS_RADIUS_METERS=100
QR_VALIDITY_MINUTES=10
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false

# For local use SQLite is created automatically. A hosted service should set
# DATABASE_URL to a persistent PostgreSQL database.
